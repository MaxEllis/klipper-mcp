[Unit]
Description=klipper-mcp capture: record finished prints from Moonraker into the shared outcome store
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=max
Group=max
WorkingDirectory=/home/max/projects/klipper-mcp
Environment=MOONRAKER_URL=http://klipper.local:7125
Environment=MOONRAKER_FALLBACK_URL=http://192.168.1.128:7125
Environment=PRINT_OUTCOMES_DIR=/home/max/projects/_shared/print-outcomes
ExecStart=/home/max/projects/klipper-mcp/.venv/bin/klipper-mcp-capture
Restart=always
RestartSec=10
MemoryMax=200M
CPUQuota=20%

# Sandbox. The service only needs: outbound TCP to Moonraker, read access to its venv,
# and write access to the outcome store. Everything else is closed off.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/max/projects/_shared/print-outcomes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
